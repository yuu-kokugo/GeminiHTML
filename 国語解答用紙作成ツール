<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <title>国語解答用紙作成システム</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Sawarabi+Mincho&family=Noto+Sans+JP:wght@400;700&display=swap');

        body {
            font-family: 'Sawarabi Mincho', serif;
            margin: 0;
            background: #525659;
            display: flex;
            flex-direction: row;
            height: 100vh;
            overflow: hidden;
            user-select: none;
        }

        /* ==========================================
           操作盤
        ========================================== */
        .control-panel {
            width: 400px;
            background: #fdfdfd;
            border-right: 1px solid #d1d5db;
            box-shadow: 2px 0 12px rgba(0,0,0,0.1);
            display: flex;
            flex-direction: column;
            z-index: 100;
            font-family: 'Noto Sans JP', sans-serif;
        }
        .panel-header {
            background: #1e293b;
            color: white;
            padding: 14px;
            font-size: 15px;
            font-weight: 700;
            text-align: center;
            letter-spacing: 0.05em;
        }
        .panel-scroll {
            flex-grow: 1;
            overflow-y: auto;
            padding: 18px;
        }
        .section-title {
            font-size: 11px;
            color: #475569;
            background: #f1f5f9;
            padding: 6px 10px;
            margin: 16px 0 10px 0;
            font-weight: 700;
            border-left: 3px solid #0f172a;
            border-radius: 0 4px 4px 0;
            letter-spacing: 0.03em;
        }
        .ui-row {
            display: flex;
            gap: 8px;
            margin-bottom: 10px;
            align-items: center;
        }
        .ui-row label { font-size: 11px; width: 85px; flex-shrink: 0; color: #334155; font-weight: 700; }
        
        input[type="text"], select, textarea {
            flex-grow: 1;
            padding: 7px 10px;
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            font-size: 13px;
            color: #1e293b;
            background: #ffffff;
            box-sizing: border-box;
        }
        select { max-width: 140px !important; }
        textarea { height: 50px; resize: none; }
        
        .calc-trigger-input {
            background: #fffbeb !important;
            border: 1px solid #fcd34d !important;
            cursor: pointer;
            font-weight: 700;
            text-align: center;
            max-width: 50px !important; 
        }

        .toggle-group {
            display: flex;
            gap: 4px;
            flex-grow: 1;
        }
        .toggle-btn {
            flex-grow: 1;
            padding: 6px 4px;
            background: #ffffff;
            color: #475569;
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            font-size: 11px;
            cursor: pointer;
            font-weight: 700;
            text-align: center;
        }
        .toggle-btn.active {
            background: #312e81 !important;
            color: white !important;
            border-color: #312e81 !important;
        }

        button {
            padding: 7px 14px;
            background: #475569;
            color: white;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-size: 12px;
            font-weight: 700;
        }
        button:hover { background: #334155; }
        .btn-insert { background: #059669; width: 100%; margin-top: 4px; }
        .btn-insert:hover { background: #10b981; }
        
        .sub-panel-box {
            background: #f8fafc;
            padding: 8px;
            border: 1px solid #e2e8f0;
            border-radius: 6px;
            margin-bottom: 8px;
        }

        /* ==========================================
           テンキー
        ========================================== */
        #popupCalc {
            position: absolute; background: #1e293b; border: 1px solid #0f172a;
            padding: 10px; border-radius: 8px; display: none;
            grid-template-columns: repeat(4, 1fr); gap: 6px; z-index: 2000;
            box-shadow: 0 10px 25px rgba(0,0,0,0.3);
        }
        #popupCalc .calc-btn {
            width: 42px; height: 38px; background: white; color: #1e293b;
            border-radius: 4px; font-size: 13px; font-weight: bold;
            display: flex; align-items: center; justify-content: center; cursor: pointer;
            box-shadow: 0 1px 2px rgba(0,0,0,0.1);
        }
        #popupCalc .calc-btn:hover { background: #f1f5f9; }
        #popupCalc .calc-btn.action { background: #ef4444; color: white; }
        #popupCalc .calc-btn.mode-switch { background: #f59e0b; color: white; grid-column: span 2; width: auto; font-size: 11px; }
        #popupCalc .calc-btn.done { background: #10b981; color: white; }

        /* ==========================================
           永続ツールバー
        ========================================== */
        .inline-toolbar {
            position: absolute; 
            top: -55px; 
            left: 0; 
            background: #1e293b;
            padding: 8px 12px; 
            border-radius: 6px; 
            display: flex; 
            gap: 10px;
            align-items: center; 
            z-index: 1000; 
            box-shadow: 0 6px 15px rgba(0,0,0,0.3);
            border: 1px solid #334155;
            width: max-content;
        }
        .inline-toolbar select { 
            padding: 5px 8px; 
            font-size: 13px; 
            font-weight: bold;
            background: white; 
            border: 1px solid #cbd5e1;
            border-radius: 4px;
            cursor: pointer;
            max-width: 200px !important;
        }

        /* ==========================================
           右側：キャンバスエリア
        ========================================== */
        .canvas-area {
            flex-grow: 1; overflow: auto; padding: 20px;
            display: flex; justify-content: center; align-items: flex-start;
        }
        #paper {
            background: white; box-shadow: 0 0 20px rgba(0,0,0,0.3);
            position: relative; box-sizing: border-box;
            background-image: linear-gradient(90deg, rgba(0,0,0,0.02) 1px, transparent 1px),
                              linear-gradient(rgba(0,0,0,0.02) 1px, transparent 1px);
            background-size: 10px 10px;
        }
        .size-B4-landscape { width: 364mm; height: 257mm; padding: 15mm; }
        .size-A4-landscape { width: 297mm; height: 210mm; padding: 10mm; }

        /* ==========================================
           配置パーツデザイン
        ========================================== */
        .field-item {
            position: absolute; cursor: move; border: 1px dotted transparent;
            padding: 6px; box-sizing: border-box; display: inline-block;
        }
        .field-item:hover { border: 1px dashed #3b82f6; }
        .field-item.selected { border: 1.5px solid #ef4444 !important; }
        
        .hover-delete-btn {
            position: absolute; top: -10px; right: -10px;
            background: #ef4444; color: white; border: none; border-radius: 50%;
            width: 20px; height: 20px; font-size: 12px; font-weight: bold;
            cursor: pointer; display: none; line-height: 18px; text-align: center; z-index: 1005;
        }
        .field-item:hover .hover-delete-btn { display: block; }

        /* 縦書き設定 */
        .vertical-text { 
            writing-mode: vertical-rl; 
            text-orientation: mixed;
            white-space: nowrap !important;
            overflow: visible;            
            display: inline-flex !important; 
            flex-direction: column;       
            min-width: 4.5em !important; 
            height: max-content;            
            align-items: center;
            justify-content: flex-start;
        }
                .shomon-rotate-box {
            display: inline-block !important;
            transform: rotate(-90deg);        
            transform-origin: center center;
            white-space: nowrap !important;   
            font-family: 'Noto Sans JP', sans-serif; 
            font-weight: 700;
            line-height: 1.0;
            margin: 5px 0;
        }

        /* 年組・クラス欄 */
        .box-meta-only {
            border: 1.5px solid #000; 
            display: inline-flex !important; 
            flex-direction: column !important; 
            align-items: center; 
            justify-content: center; 
            height: 250px; 
            width: 80px; 
            font-size: 18pt; 
            font-weight: bold; 
            text-align: center;
            box-sizing: border-box; 
            writing-mode: vertical-rl;
            text-orientation: upright;
            padding: 15px 0;
            line-height: 1.2;
        }
        .year-group-content::before {
            content: "  年   組";
            white-space: pre !important;
        }
        .year-class-content::before {
            content: "  年  クラス";
            white-space: pre !important;
        }
        
        /* 氏名欄 */
        .box-name-only { 
            border: 1.5px solid #000; 
            display: flex; 
            flex-direction: column;
            align-items: flex-start; 
            justify-content: flex-start; 
            height: 260px; 
            width: 65px; 
            box-sizing: border-box; 
            writing-mode: vertical-rl; 
            padding: 8px 6px;
        }
        .box-name-only .lbl {
            font-size: 9pt; 
            font-weight: normal;
            color: #333;
            margin-bottom: 10px;
        }

        /* 配点ボックス */
        .independent-score-wrapper {
            display: flex; flex-direction: column; align-items: center; width: fit-content;
        }
        .score-box { border: 1.2px solid #000; width: 35px; height: 35px; flex-shrink: 0; }
        .score-val { font-size: 8pt; margin-top: 1px; text-align: center; width: 100%; writing-mode: horizontal-tb; }

        /* 解答欄＆マス目サイズ */
        .answer-wrapper { display: flex; flex-direction: column; align-items: center; width: fit-content; }
        .blank-box { border: 1.5px solid #000; width: 35px; box-sizing: border-box; }
        .extract-grid-container { display: flex; flex-direction: row-reverse; gap: 8px; }
        .extract-block { display: flex; flex-direction: column; align-items: center; }
        .extract-lbl { font-size: 8pt; font-weight: bold; margin-bottom: 2px; }
        
        /* マスなしボックス：縦幅をマスあり15文字分より一回り大きい「550px」に固定、横幅も1列あたり「45px」に設定 */
        .masu-less-box { border: 1.5px solid #000; box-sizing: border-box; padding: 0; }

        /* 原稿用紙マス（35px正方形） */
        .genkou-grid { display: flex; flex-direction: row-reverse; gap: 0; }
        .grid-line { display: flex; flex-direction: column; border-top: 1px solid #000; border-right: 1px solid #000; }
        .cell { width: 35px; height: 35px; border-bottom: 1px solid #000; border-left: 1px solid #000; box-sizing: border-box; }
        .min-line { border-bottom: 4px double #000 !important; }

        @media print {
            .control-panel, #popupCalc, .inline-toolbar, .hover-delete-btn { display: none !important; }
            body { background: none; } .canvas-area { padding: 0; overflow: visible; }
            #paper { margin: 0; box-shadow: none; border: none; background-image: none; }
            .field-item { border: none !important; background: transparent !important; }
            @page { size: landscape; margin: 0; }
        }
    </style>
</head>
<body onclick="deselectAll(event)">

<div id="popupCalc" onclick="event.stopPropagation()">
    <div class="calc-btn mode-switch" id="calcModeBtn" onclick="toggleCalcMode()">➔ 漢数字へ</div>
    <div class="calc-btn action" onclick="pressPopupCalc('C')">C</div>
    <div class="calc-btn action" onclick="pressPopupCalc('BACK')">←</div>
    
    <div class="calc-btn" onclick="pressPopupCalc('7')" data-num="7">7</div>
    <div class="calc-btn" onclick="pressPopupCalc('8')" data-num="8">8</div>
    <div class="calc-btn" onclick="pressPopupCalc('9')" data-num="9">9</div>
    <div class="calc-btn done" onclick="closePopupCalc()">確定</div>
    
    <div class="calc-btn" onclick="pressPopupCalc('4')" data-num="4">4</div>
    <div class="calc-btn" onclick="pressPopupCalc('5')" data-num="5">5</div>
    <div class="calc-btn" onclick="pressPopupCalc('6')" data-num="6">6</div>
    <div class="calc-btn" onclick="pressPopupCalc('00')" data-num="00">00</div>
    
    <div class="calc-btn" onclick="pressPopupCalc('1')" data-num="1">1</div>
    <div class="calc-btn" onclick="pressPopupCalc('2')" data-num="2">2</div>
    <div class="calc-btn" onclick="pressPopupCalc('3')" data-num="3">3</div>
    <div class="calc-btn" onclick="pressPopupCalc('0')" data-num="0">0</div>
</div>

<div class="control-panel" onclick="event.stopPropagation()">
    <div class="panel-header">国語解答用紙作成システム</div>
    <div class="panel-scroll">
        
        <div class="section-title">用紙の土台</div>
        <div class="ui-row">
            <label>用紙サイズ</label>
            <select id="pageSize" onchange="changePaperSize()">
                <option value="size-B4-landscape">B4 横サイズ (標準)</option>
                <option value="size-A4-landscape">A4 横サイズ</option>
            </select>
        </div>

        <div class="section-title">1. タイトル</div>
        <div class="ui-row">
            <input type="text" id="inputTitleText" value="令和八年度 定期考査 国語">
            <button onclick="addTitleField()" style="width:60px;">挿入</button>
        </div>

        <div class="section-title">2. 年組欄／年クラス欄</div>
        <div class="ui-row">
            <button onclick="addMetaField('year-group')" style="flex-grow: 1;">【年 組】挿入</button>
            <button onclick="addMetaField('year-class')" style="flex-grow: 1;">【年クラス】挿入</button>
        </div>

        <div class="section-title">3. 氏名欄</div>
        <button class="btn-insert" onclick="addNameField()">【氏名】を挿入</button>

        <div class="section-title">4. 自由文言</div>
        <textarea id="inputFreeText" placeholder="例：問題は裏面に続きます。"></textarea>
        <button class="btn-insert" onclick="addFreeTextField()">自由文言を挿入</button>

        <div class="section-title">5. 大問</div>
        <div class="ui-row">
            <div class="toggle-group">
                <div class="toggle-btn active" onclick="setToggle('daimon', this, '大問')">大問</div>
                <div class="toggle-btn" onclick="setToggle('daimon', this, '【】')">【】</div>
                <div class="toggle-btn" onclick="setToggle('daimon', this, '1⃣')">直接</div>
                <div class="toggle-btn" onclick="setToggle('daimon', this, '第問')">第問</div>
            </div>
        </div>
        <div class="ui-row">
            <label>記号・数字</label>
            <input type="text" id="daimonNum" class="calc-trigger-input" value="一" readonly onclick="openPopupCalc(event, this)">
            <button onclick="insertDaimon()">大問を挿入</button>
        </div>

        <div class="section-title">6. 小問</div>
        <div class="ui-row">
            <div class="toggle-group">
                <div class="toggle-btn active" onclick="setToggle('shomon', this, '（）')">（問）</div>
                <div class="toggle-btn" onclick="setToggle('shomon', this, '問')">問〇</div>
                <div class="toggle-btn" onclick="setToggle('shomon', this, '①')">直接</div>
            </div>
        </div>
        <div class="ui-row">
            <label>数字入力</label>
            <input type="text" id="shomonNum" class="calc-trigger-input" value="1" readonly onclick="openPopupCalc(event, this)">
            <button onclick="insertShomon()">小問を挿入</button>
        </div>

        <div class="section-title">7. 配点ボックス</div>
        <div class="ui-row">
            <label>配点点数</label>
            <input type="text" id="inputScore" class="calc-trigger-input" value="5" readonly onclick="openPopupCalc(event, this)">
            <button onclick="addIndependentScore()" style="flex-grow:1;">配点ボックスを挿入</button>
        </div>

        <div class="section-title">8. 解答欄</div>
        
        <div class="sub-panel-box">
            <div class="ui-row">
                <label>選択肢の数</label>
                <select id="choiceNumSelect">
                    <option value="1">1つ</option>
                    <option value="2">2つ連動</option>
                    <option value="3">3つ連動</option>
                </select>
            </div>
            <button class="btn-insert" onclick="addAnswerColumn('choice')">選択肢 解答欄を挿入</button>
        </div>
        
        <div class="sub-panel-box">
            <div class="ui-row">
                <label>総文字数</label>
                <input type="text" id="gridMaxFree" class="calc-trigger-input" value="30" readonly onclick="openPopupCalc(event, this)">
                <select id="masuSelectStyle">
                    <option value="with-masu">マスあり</option>
                    <option value="without-masu">マスなし</option>
                </select>
            </div>
            <button class="btn-insert" onclick="addAnswerColumn('grid-free')">記述 解答欄を挿入</button>
        </div>

        <div class="sub-panel-box">
            <div class="ui-row">
                <input type="text" id="gridMinRange" class="calc-trigger-input" value="20" readonly onclick="openPopupCalc(event, this)">
                <span>〜</span>
                <input type="text" id="gridMaxRange" class="calc-trigger-input" value="30" readonly onclick="openPopupCalc(event, this)">
                <span>字 (マスあり)</span>
            </div>
            <button class="btn-insert" onclick="addAnswerColumn('grid-range')">以上以内 解答欄を挿入</button>
        </div>

        <div class="sub-panel-box">
            <div class="ui-row">
                <label>初めの文字</label><input type="text" id="extStartNum" class="calc-trigger-input" value="3" readonly onclick="openPopupCalc(event, this)">
                <label>終わりの文字</label><input type="text" id="extEndNum" class="calc-trigger-input" value="3" readonly onclick="openPopupCalc(event, this)">
            </div>
            <button class="btn-insert" onclick="addAnswerColumn('extract')">始め終わり 解答欄を挿入</button>
        </div>

        <div class="section-title" style="margin-top:25px;">印刷</div>
        <button onclick="window.print()" style="width:100%; background:#1e293b; padding:12px; font-size:14px; border-radius: 6px;">印刷・PDF保存</button>
    </div>
</div>

<div class="canvas-area">
    <div id="paper" class="size-B4-landscape"></div>
</div>

<script>
    const paper = document.getElementById('paper');
    const popupCalc = document.getElementById('popupCalc');
    let activeItem = null; let selectedItem = null; let currentCalcTarget = null;
    let offsetX = 0, offsetY = 0;
    let isFirstKey = true;

    let selectedDaimonStyle = '大問';
    let selectedShomonStyle = '（）';
    let currentCalcMode = 'arabic'; 
    const kanjiMap = { '7':'七', '8':'八', '9':'九', '4':'四', '5':'五', '6':'六', '1':'一', '2':'二', '3':'三', '0':'〇', '00':'〇〇' };

    function toFullWidth(str) {
        return str.replace(/[A-Za-z0-9]/g, function(s) {
            return String.fromCharCode(s.charCodeAt(0) + 0xFEE0);
        });
    }

    function changePaperSize() { paper.className = document.getElementById('pageSize').value; }

    function setToggle(type, element, value) {
        const parent = element.parentElement;
        parent.querySelectorAll('.toggle-btn').forEach(btn => btn.classList.remove('active'));
        element.classList.add('active');
        if(type === 'daimon') selectedDaimonStyle = value;
        if(type === 'shomon') selectedShomonStyle = value;
    }

    function toggleCalcMode() {
        const btn = document.getElementById('calcModeBtn');
        const numBtns = popupCalc.querySelectorAll('div[data-num]');
        if (currentCalcMode === 'arabic') {
            currentCalcMode = 'kanji'; btn.innerText = "➔ 算用数字へ"; btn.style.background = "#312e81";
            numBtns.forEach(b => { const orig = b.getAttribute('data-num'); b.innerText = kanjiMap[orig] || orig; });
        } else {
            currentCalcMode = 'arabic'; btn.innerText = "➔ 漢数字へ"; btn.style.background = "#f59e0b";
            numBtns.forEach(b => { const orig = b.getAttribute('data-num'); b.innerText = orig; });
        }
    }

    function openPopupCalc(e, targetInput) {
        e.stopPropagation(); currentCalcTarget = targetInput; isFirstKey = true;
        popupCalc.style.display = 'grid';
        popupCalc.style.left = (e.clientX + 10) + 'px'; popupCalc.style.top = (e.clientY - 50) + 'px';
    }

    function pressPopupCalc(val) {
        if (!currentCalcTarget) return;
        if (val === 'C') { currentCalcTarget.value = "0"; isFirstKey = true; return; }
        if (val === 'BACK') { currentCalcTarget.value = currentCalcTarget.value.slice(0, -1) || "0"; return; }

        let inputChar = (currentCalcMode === 'kanji') ? (kanjiMap[val] || val) : val;
        if (isFirstKey) { currentCalcTarget.value = inputChar; isFirstKey = false; } 
        else {
            if (currentCalcTarget.value === "0" || currentCalcTarget.value === "〇") currentCalcTarget.value = inputChar;
            else currentCalcTarget.value += inputChar;
        }
    }
    function closePopupCalc() { popupCalc.style.display = 'none'; currentCalcTarget = null; }

    function createInlineToolbar(parentEl) {
        const toolbar = document.createElement('div');
        toolbar.className = 'inline-toolbar';
        toolbar.onclick = (e) => e.stopPropagation();

        const fontSel = document.createElement('select');
        fontSel.innerHTML = `<option value="'Sawarabi Mincho', serif">明朝体</option><option value="'Noto Sans JP', sans-serif">ゴシック体</option>`;
        fontSel.value = parentEl.style.fontFamily.includes('Noto') ? "'Noto Sans JP', sans-serif" : "'Sawarabi Mincho', serif";
        fontSel.onchange = () => {
            parentEl.style.fontFamily = fontSel.value;
            // toolbarそのものはフォント変更を無視するように設定
            parentEl.querySelectorAll(':not(.inline-toolbar):not(.inline-toolbar *)').forEach(child => child.style.fontFamily = fontSel.value);
        };
        toolbar.appendChild(fontSel);

        const sizeSel = document.createElement('select');
        sizeSel.innerHTML = `<option value="10pt">10pt</option><option value="12pt">12pt</option><option value="14pt">14pt</option><option value="18pt">18pt</option><option value="24pt">24pt</option><option value="28pt">28pt</option><option value="36pt">36pt</option>`;
        sizeSel.value = parentEl.style.fontSize || '12pt';
        sizeSel.onchange = () => { parentEl.style.fontSize = sizeSel.value; };
        toolbar.appendChild(sizeSel);

        return toolbar;
    }

    function makeElementInteractive(el) {
        el.addEventListener('click', (e) => {
            e.stopPropagation();
            if (e.target.tagName === 'SELECT' || e.target.classList.contains('hover-delete-btn')) return;
            if (selectedItem && selectedItem !== el) { removeCurrentToolbar(); }
            if (!el.classList.contains('selected')) {
                selectedItem = el; el.classList.add('selected');
                el.appendChild(createInlineToolbar(el));
            }
            closePopupCalc();
        });

        el.addEventListener('mousedown', (e) => {
            if (e.target.tagName === 'SELECT' || e.target.classList.contains('hover-delete-btn')) return;
            activeItem = el;
            offsetX = e.clientX - el.offsetLeft; offsetY = e.clientY - el.offsetTop;
            el.style.zIndex = 500;
        });
    }

    document.addEventListener('mousemove', (e) => {
        if (!activeItem) return;
        let x = Math.round((e.clientX - offsetX) / 10) * 10;
        let y = Math.round((e.clientY - offsetY) / 10) * 10;
        activeItem.style.left = Math.max(0, x) + 'px'; activeItem.style.top = Math.max(0, y) + 'px';
    });
    document.addEventListener('mouseup', () => { if (activeItem) { activeItem.style.zIndex = ''; activeItem = null; } });

    function removeCurrentToolbar() {
        if (selectedItem) {
            const toolbar = selectedItem.querySelector('.inline-toolbar');
            if (toolbar) toolbar.remove();
            selectedItem.classList.remove('selected'); selectedItem = null;
        }
    }
    
    function deselectAll(e) { removeCurrentToolbar(); closePopupCalc(); }

    function createBaseField() {
        const item = document.createElement('div');
        item.className = 'field-item'; item.style.left = '100px'; item.style.top = '100px';
        const del = document.createElement('button');
        del.className = 'hover-delete-btn'; del.innerText = '×';
        del.onclick = (e) => { item.remove(); removeCurrentToolbar(); e.stopPropagation(); };
        item.appendChild(del);
        makeElementInteractive(item);
        return item;
    }

    function addTitleField() {
        const text = document.getElementById('inputTitleText').value;
        const item = createBaseField(); item.className += ' vertical-text';
        item.style.fontSize = '28pt'; item.style.fontWeight = 'bold'; item.style.letterSpacing = '0.3em';
        
        const span = document.createElement('span');
        span.appendChild(document.createTextNode(text));
        item.appendChild(span);
        paper.appendChild(item);
    }

    function addFreeTextField() {
        const text = document.getElementById('inputFreeText').value;
        const item = createBaseField(); item.className += ' vertical-text';
        item.style.fontSize = '12pt'; item.style.lineHeight = '1.8';
        
        const div = document.createElement('div');
        div.innerHTML = text.replace(/\n/g, '<br>');
        item.appendChild(div);
        paper.appendChild(item);
    }

    function insertDaimon() {
        const num = toFullWidth(document.getElementById('daimonNum').value);
        let finalStr = "";
        if(selectedDaimonStyle === '大問') finalStr = `大問${num}`;
        else if(selectedDaimonStyle === '【】') finalStr = `【${num}】`;
        else if(selectedDaimonStyle === '1⃣') finalStr = num;
        else if(selectedDaimonStyle === '第問') finalStr = `第${num}問`;
        const item = createBaseField(); item.className += ' vertical-text';
        item.style.fontSize = '18pt'; item.style.fontWeight = 'bold';
        
        const span = document.createElement('span');
        span.appendChild(document.createTextNode(finalStr));
        item.appendChild(span);
        paper.appendChild(item);
    }

    function insertShomon() {
        const num = document.getElementById('shomonNum').value;
        const item = createBaseField(); item.className += ' vertical-text';
        item.style.fontSize = '14pt'; item.style.fontWeight = 'bold';
        
        // 【重要】外枠(item)ではなく、内側の文字だけを格納するコンテナを用意
        const contentBox = document.createElement('span');
        
        if (selectedShomonStyle === '（）') {
            contentBox.innerHTML = `<span class="shomon-rotate-box">(${num})</span>`;
        } else if (selectedShomonStyle === '問') {
            contentBox.appendChild(document.createTextNode(`問${toFullWidth(num)}`));
        } else if (selectedShomonStyle === '①') {
            contentBox.appendChild(document.createTextNode(toFullWidth(num)));
        }
        item.appendChild(contentBox);
        paper.appendChild(item);
    }

    function addMetaField(type) {
        const item = createBaseField();
        const box = document.createElement('div');
        if (type === 'year-group') {
            box.className = 'box-meta-only year-group-content';
        } else {
            box.className = 'box-meta-only year-class-content';
        }
        item.appendChild(box); paper.appendChild(item);
    }

    function addNameField() {
        const item = createBaseField();
        const box = document.createElement('div');
        box.className = 'box-name-only';
        box.innerHTML = `<div class="lbl">氏名</div>`;
        item.appendChild(box); paper.appendChild(item);
    }

    function addIndependentScore() {
        const score = toFullWidth(document.getElementById('inputScore').value);
        const item = createBaseField();
        const wrapper = document.createElement('div');
        wrapper.className = 'independent-score-wrapper';
        const sBox = document.createElement('div'); sBox.className = 'score-box'; wrapper.appendChild(sBox);
        const sVal = document.createElement('div'); sVal.className = 'score-val'; sVal.innerText = `/${score}`; wrapper.appendChild(sVal);
        item.appendChild(wrapper); paper.appendChild(item);
    }

    function addAnswerColumn(mode) {
        const item = createBaseField();
        const wrapper = document.createElement('div'); wrapper.className = 'answer-wrapper';

        if (mode === 'choice') {
            const count = parseInt(document.getElementById('choiceNumSelect').value) || 1;
            const container = document.createElement('div');
            container.style.display = 'flex'; container.style.flexDirection = 'column'; container.style.gap = '4px';
            for (let i = 0; i < count; i++) {
                const blank = document.createElement('div'); blank.className = 'blank-box';
                blank.style.height = '65px'; container.appendChild(blank);
            }
            wrapper.appendChild(container);
        } 
        else if (mode === 'extract') {
            const startNum = parseInt(document.getElementById('extStartNum').value) || 0;
            const endNum = parseInt(document.getElementById('extEndNum').value) || 0;
            const container = document.createElement('div'); container.className = 'extract-grid-container';

            if (startNum > 0) {
                const bStart = document.createElement('div'); bStart.className = 'extract-block';
                bStart.innerHTML = '<div class="extract-lbl">初め</div>';
                const gStart = document.createElement('div'); gStart.className = 'genkou-grid';
                const lineS = document.createElement('div'); lineS.className = 'grid-line';
                for(let i=0; i<startNum; i++) { const c = document.createElement('div'); c.className = 'cell'; lineS.appendChild(c); }
                gStart.appendChild(lineS); bStart.appendChild(gStart); container.appendChild(bStart);
            }
            if (endNum > 0) {
                const bEnd = document.createElement('div'); bEnd.className = 'extract-block';
                bEnd.innerHTML = '<div class="extract-lbl">終わり</div>';
                const gEnd = document.createElement('div'); gEnd.className = 'genkou-grid';
                const lineE = document.createElement('div'); lineE.className = 'grid-line';
                for(let i=0; i<endNum; i++) { const c = document.createElement('div'); c.className = 'cell'; lineE.appendChild(c); }
                gEnd.appendChild(lineE); bEnd.appendChild(gEnd); container.appendChild(bEnd);
            }
            if (startNum > 0 || endNum > 0) wrapper.appendChild(container);
        }
        else {
            let max = 30, min = 0, styleVal = "with-masu";
            if (mode === 'grid-free') {
                max = parseInt(document.getElementById('gridMaxFree').value) || 30;
                styleVal = document.getElementById('masuSelectStyle').value;
            } else if (mode === 'grid-range') {
                min = parseInt(document.getElementById('gridMinRange').value) || 0;
                max = parseInt(document.getElementById('gridMaxRange').value) || 30;
                styleVal = "with-masu";
            }

            if (styleVal === 'without-masu') {
                const noMasuBox = document.createElement('div'); noMasuBox.className = 'masu-less-box';
                const linesCount = Math.ceil(max / 15);
                noMasuBox.style.height = "550px"; 
                noMasuBox.style.width = (linesCount * 45) + 'px'; 
                wrapper.appendChild(noMasuBox);
            } else {
                const grid = document.createElement('div'); grid.className = 'genkou-grid';
                let currentLine;
                for(let i = 1; i <= max; i++) {
                    if((i - 1) % 15 === 0) {
                        currentLine = document.createElement('div'); currentLine.className = 'grid-line'; grid.appendChild(currentLine);
                    }
                    const cell = document.createElement('div'); cell.className = 'cell';
                    if(mode === 'grid-range' && min > 0 && i === min) cell.className += ' min-line';
                    currentLine.appendChild(cell);
                }
                wrapper.appendChild(grid);
            }
        }
        item.appendChild(wrapper); paper.appendChild(item);
    }
</script>
</body>
</html>
